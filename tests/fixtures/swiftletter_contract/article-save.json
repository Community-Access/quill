{
	"contract_version": 1,
	"name": "article-save",
	"description": "A contributor saves their own article through a real application password with If-Match. A save keeps the article a draft, clears its review, and is refused with 412 once the article has changed on the site.",
	"steps": [
		{
			"id": "open-article",
			"request": {
				"as": "contributor",
				"method": "GET",
				"route": "/wp/v2/swl-articles/{{articles.garden.id}}",
				"query": { "context": "edit" }
			},
			"response": {
				"status": 200,
				"body": {
					"status": "draft",
					"swiftletter": { "review_state": "reviewed", "edit_version": { "$pattern": "^\"[0-9a-f]{64}\"$" } }
				}
			},
			"capture": { "opened_version": "swiftletter.edit_version" }
		},
		{
			"id": "save-without-version",
			"request": {
				"as": "contributor",
				"method": "POST",
				"route": "/swiftletter/v1/articles/{{articles.garden.id}}/save",
				"json": { "title": "{{articles.garden.title}}", "content": "{{articles.garden.content}}" }
			},
			"response": {
				"status": 428,
				"body": {
					"code": "swiftletter_version_required",
					"message": "Refresh the article before saving.",
					"data": { "status": 428 }
				}
			}
		},
		{
			"id": "save-with-wildcard-version",
			"request": {
				"as": "contributor",
				"method": "POST",
				"route": "/swiftletter/v1/articles/{{articles.garden.id}}/save",
				"headers": { "If-Match": "*" },
				"json": { "title": "{{articles.garden.title}}", "content": "{{articles.garden.content}}" }
			},
			"response": {
				"status": 400,
				"body": {
					"code": "swiftletter_invalid_version",
					"message": "The article version is invalid. Refresh the article and try again.",
					"data": { "status": 400 }
				}
			}
		},
		{
			"id": "save-cannot-publish",
			"request": {
				"as": "contributor",
				"method": "POST",
				"route": "/swiftletter/v1/articles/{{articles.garden.id}}/save",
				"headers": { "If-Match": "{{captures.opened_version}}" },
				"json": { "title": "{{articles.garden.title}}", "content": "{{articles.garden.content}}", "status": "publish" }
			},
			"response": {
				"status": 400,
				"body": {
					"code": "swiftletter_invalid_save",
					"message": "Send the article title and content only.",
					"data": { "status": 400 }
				}
			},
			"site": { "article_status": { "garden": "draft" }, "article_review_confirmed": { "garden": true } }
		},
		{
			"id": "save-current-version",
			"request": {
				"as": "contributor",
				"method": "POST",
				"route": "/swiftletter/v1/articles/{{articles.garden.id}}/save",
				"headers": { "If-Match": "{{captures.opened_version}}" },
				"json": {
					"title": "Community Garden Opens Its Gates on Saturday",
					"content": "<!-- wp:heading -->\n<h2 class=\"wp-block-heading\" id=\"planting-day\">Planting day</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Volunteers planted forty-two raised beds on Saturday. Read the <a href=\"https://example.org/lantern-street/garden-rota\">garden rota</a> to sign up for watering.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:image -->\n<figure class=\"wp-block-image\"><img src=\"https://example.org/lantern-street/raised-beds.jpg\" alt=\"Two volunteers lift a wooden raised bed into place beside a brick wall.\"/></figure>\n<!-- /wp:image -->"
				}
			},
			"response": {
				"status": 200,
				"headers": { "ETag": "{{body.edit_version}}", "Cache-Control": { "$pattern": "no-store" } },
				"body": {
					"id": "{{articles.garden.id}}",
					"edit_version": { "$pattern": "^\"[0-9a-f]{64}\"$", "$not": "{{captures.opened_version}}" }
				},
				"example": {
					"id": "{{articles.garden.id}}",
					"edit_version": "\"9a8b7c6d5e4f30211203f4e5d6c7b8a99a8b7c6d5e4f30211203f4e5d6c7b8a9\""
				}
			},
			"capture": { "saved_version": "edit_version" },
			"site": {
				"article_status": { "garden": "draft" },
				"article_review_confirmed": { "garden": false, "market": true },
				"newsletter_status": { "gazette": "draft" },
				"new_public_posts": 0
			}
		},
		{
			"id": "reopen-shows-saved-draft-not-reviewed",
			"description": "WordPress sanitises a contributor's content (kses), so the stored text can differ from what was sent: here the image's \"/>\" becomes \" />\".",
			"request": {
				"as": "contributor",
				"method": "GET",
				"route": "/wp/v2/swl-articles/{{articles.garden.id}}",
				"query": { "context": "edit" }
			},
			"response": {
				"status": 200,
				"body": {
					"status": "draft",
					"title": { "raw": "Community Garden Opens Its Gates on Saturday" },
					"content": { "raw": "<!-- wp:heading -->\n<h2 class=\"wp-block-heading\" id=\"planting-day\">Planting day</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Volunteers planted forty-two raised beds on Saturday. Read the <a href=\"https://example.org/lantern-street/garden-rota\">garden rota</a> to sign up for watering.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:image -->\n<figure class=\"wp-block-image\"><img src=\"https://example.org/lantern-street/raised-beds.jpg\" alt=\"Two volunteers lift a wooden raised bed into place beside a brick wall.\" /></figure>\n<!-- /wp:image -->" },
					"swiftletter": { "review_state": "not_reviewed", "edit_version": "{{captures.saved_version}}" }
				}
			}
		},
		{
			"id": "editor-sees-review-cleared",
			"request": { "as": "editor", "method": "GET", "route": "/swiftletter/v1/newsletters/{{newsletters.gazette.id}}" },
			"response": {
				"status": 200,
				"body": {
					"articles": [
						{ "id": "{{articles.garden.id}}", "title": "Community Garden Opens Its Gates on Saturday", "review_confirmed": false },
						{ "id": "{{articles.market.id}}", "review_confirmed": true }
					]
				}
			}
		},
		{
			"id": "replaying-old-version-is-refused",
			"request": {
				"as": "contributor",
				"method": "POST",
				"route": "/swiftletter/v1/articles/{{articles.garden.id}}/save",
				"headers": { "If-Match": "{{captures.opened_version}}" },
				"json": { "title": "Stale title", "content": "<!-- wp:paragraph --><p>Stale content.</p><!-- /wp:paragraph -->" }
			},
			"response": {
				"status": 412,
				"body": {
					"code": "swiftletter_precondition_failed",
					"message": "This article changed on the site. Refresh it before saving.",
					"data": { "status": 412 }
				}
			}
		},
		{
			"id": "editor-changes-article-in-wordpress",
			"description": "The block editor saves through the core posts route. This makes the contributor's saved_version stale.",
			"request": {
				"as": "editor",
				"method": "POST",
				"route": "/wp/v2/swl-articles/{{articles.garden.id}}",
				"json": { "content": "<!-- wp:paragraph --><p>The editor tidied this in WordPress.</p><!-- /wp:paragraph -->" }
			},
			"response": { "status": 200, "body": { "id": "{{articles.garden.id}}", "status": "draft" } }
		},
		{
			"id": "stale-save-after-wordpress-edit-is-refused",
			"request": {
				"as": "contributor",
				"method": "POST",
				"route": "/swiftletter/v1/articles/{{articles.garden.id}}/save",
				"headers": { "If-Match": "{{captures.saved_version}}" },
				"json": { "title": "Community Garden Opens Its Gates on Saturday", "content": "<!-- wp:paragraph --><p>QUILL's local draft.</p><!-- /wp:paragraph -->" }
			},
			"response": {
				"status": 412,
				"body": { "code": "swiftletter_precondition_failed", "message": "This article changed on the site. Refresh it before saving." }
			},
			"site": { "article_content": { "garden": "<!-- wp:paragraph --><p>The editor tidied this in WordPress.</p><!-- /wp:paragraph -->" }, "new_public_posts": 0 }
		}
	]
}
