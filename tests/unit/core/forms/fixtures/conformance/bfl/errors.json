{
  "about": "BFL that must be reported as an error, with the line the error is on. 'contains' is a hint; only the line is binding for other readers.",
  "cases": [
    { "name": "a newer BFL version", "line": 1, "contains": "BFL 2", "bfl": "bfl 2\nform \"Later\"\ntext #a \"A\"\n" },
    { "name": "a version line without a number", "line": 1, "contains": "version number", "bfl": "bfl\nform \"X\"\n" },
    { "name": "a condition that does not parse", "line": 3, "contains": "not valid", "bfl": "form \"X\"\ntext #a \"A\"\n  @when #b is\n" },
    { "name": "an if block whose condition does not parse", "line": 2, "contains": "not valid", "bfl": "form \"X\"\nif #a is one of \"b\"\n  text #c \"C\"\n" },
    { "name": "a calculation that does not parse", "line": 3, "contains": "not valid", "bfl": "form \"X\"\ncalculation #t \"Total\"\n  @calculate #a * \n" },
    { "name": "an unclosed quote", "line": 2, "contains": "not closed", "bfl": "form \"X\"\ntext #a \"Unclosed\n" },
    { "name": "a rule without an action", "line": 2, "contains": "action", "bfl": "form \"X\"\nrule\n  @when #a is 1\n" },
    { "name": "a library without a name", "line": 2, "contains": "name", "bfl": "form \"X\"\nlibrary\n  + A\n" },
    { "name": "a translation without a language", "line": 2, "contains": "language", "bfl": "form \"X\"\ntranslation\n  @title \"Y\"\n" },
    { "name": "extensions that are not JSON", "line": 2, "contains": "JSON", "bfl": "form \"X\"\n  @extensions nope\n" }
  ]
}
