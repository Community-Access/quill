form "Contact Us" @description "Write to us"
@ajax
@honeypot
@captcha "hcaptcha"
@submit_label "Send Message"
@success_message "Thank you for contacting us!"

// Indentation modifiers
text #name "Your Name"
  @required
  @placeholder "Enter your name"
  @maxlength 100
text #last "Last Name" @required @placeholder "Last name"
/* Block styles */
text #b1 "Brace" { @required @placeholder "Enter name" }
text #b2 "Multiline brace" {
  @required
  @minlength 2
}
text #b3 "Bracket" [ @required @placeholder "Enter name" ]
text #b4 "Begin" begin
  @required
  @description "Shown under the box"
end
textarea #message "Your Message"
@required
@min 20
@max 1000
@rows 6
submit "Send Message"
