{
  "about": "A subset of QAF's conformance manifest (tests/conformance/manifest.json on QAF's chore/rename-qaf branch, beb3e2c), vendored so CI always runs some cases. Same shape as QAF's; the schema is quill/core/forms/schema/form.schema.json.",
  "model_version": 1,
  "bfl_version": 1,
  "suites": [
    {
      "kind": "schema",
      "file": "../../../../../../quill/core/forms/schema/form.schema.json"
    },
    {
      "kind": "expressions",
      "file": "expressions/cases.json"
    },
    {
      "kind": "expressions",
      "file": "expressions/php-edges.json"
    },
    {
      "kind": "valid-models",
      "files": [
        "models/valid/logic-and-layout.json",
        "models/valid/quiz-and-translations.json",
        "qaf/canonical/edge-cases.json",
        "qaf/canonical/priced-choices.json"
      ]
    },
    {
      "kind": "invalid-models",
      "file": "models/invalid/cases.json"
    },
    {
      "kind": "behaviour",
      "file": "models/behaviour.json"
    },
    {
      "kind": "qaf-canonical",
      "cases": [
        {
          "qaf": "qaf/canonical/logic-and-layout.qaf",
          "model": "models/valid/logic-and-layout.json"
        },
        {
          "qaf": "qaf/canonical/quiz-and-translations.qaf",
          "model": "models/valid/quiz-and-translations.json"
        },
        {
          "qaf": "qaf/canonical/edge-cases.qaf",
          "model": "qaf/canonical/edge-cases.json"
        },
        {
          "qaf": "qaf/canonical/priced-choices.qaf",
          "model": "qaf/canonical/priced-choices.json"
        }
      ]
    },
    {
      "kind": "qaf-legacy",
      "cases": [
        {
          "qaf": "qaf/legacy/choices.qaf",
          "model": "qaf/legacy/choices.json",
          "canonical": "qaf/legacy/choices.canonical.qaf"
        },
        {
          "qaf": "qaf/legacy/conditions.qaf",
          "model": "qaf/legacy/conditions.json",
          "canonical": "qaf/legacy/conditions.canonical.qaf"
        },
        {
          "qaf": "qaf/legacy/modifiers-and-blocks.qaf",
          "model": "qaf/legacy/modifiers-and-blocks.json",
          "canonical": "qaf/legacy/modifiers-and-blocks.canonical.qaf"
        },
        {
          "qaf": "qaf/legacy/library-keywords.qaf",
          "model": "qaf/legacy/library-keywords.json",
          "canonical": "qaf/legacy/library-keywords.canonical.qaf"
        }
      ]
    },
    {
      "kind": "qaf-errors",
      "file": "qaf/errors.json"
    }
  ]
}
