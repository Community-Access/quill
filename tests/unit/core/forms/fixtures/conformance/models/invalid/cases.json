{
  "about": "Each model here must be rejected. 'path' is the JSON pointer of at least one reported error; 'contains' is text that error's message includes (readers may word messages their own way, so only the path is binding for other implementations).",
  "cases": [
    { "name": "no version", "path": "/", "contains": "version",
      "model": { "title": "T", "pages": [ { "id": "page_1", "items": [] } ] } },
    { "name": "a newer version", "path": "/version", "contains": "1",
      "model": { "version": 2, "title": "T", "pages": [ { "id": "page_1", "items": [] } ] } },
    { "name": "no pages", "path": "/pages", "contains": "at least 1",
      "model": { "version": 1, "title": "T", "pages": [] } },
    { "name": "unknown top-level property", "path": "/colour", "contains": "Unknown property",
      "model": { "version": 1, "title": "T", "colour": "red", "pages": [ { "id": "page_1", "items": [] } ] } },
    { "name": "unknown field type", "path": "/pages/0/items/0/type", "contains": "one of",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "telepathy" } ] } ] } },
    { "name": "bad field id", "path": "/pages/0/items/0/id", "contains": "pattern",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "first name", "type": "text" } ] } ] } },
    { "name": "choice field without choices", "path": "/pages/0/items/0", "contains": "choices",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "radio" } ] } ] } },
    { "name": "calculation without an expression", "path": "/pages/0/items/0", "contains": "calculation",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "calculation" } ] } ] } },
    { "name": "matrix without rows", "path": "/pages/0/items/0/props", "contains": "rows",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "matrix", "props": { "columns": ["x"] } } ] } ] } },
    { "name": "items on a field that is not a repeater", "path": "/pages/0/items/0", "contains": "repeater",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text", "items": [] } ] } ] } },
    { "name": "a prop with a reserved name", "path": "/pages/0/items/0/props/required", "contains": "not allowed",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text", "props": { "required": true } } ] } ] } },
    { "name": "an event handler attribute", "path": "/pages/0/items/0/attributes/onclick", "contains": "not allowed",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text", "attributes": { "onclick": "x()" } } ] } ] } },
    { "name": "an expression that does not parse", "path": "/pages/0/items/0/when", "contains": "expression",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text", "when": "#b is" } ] } ] } },
    { "name": "an expression naming a missing field", "path": "/pages/0/items/0/when", "contains": "#nobody",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text", "when": "#nobody is 1" } ] } ] } },
    { "name": "the same ID twice", "path": "/pages/0/items/1/id", "contains": "twice",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text" }, { "id": "a", "type": "email" } ] } ] } },
    { "name": "a field ID that is also a page ID", "path": "/pages/0/items/0/id", "contains": "twice",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "page_1", "type": "text" } ] } ] } },
    { "name": "a set rule without a value", "path": "/rules/0", "contains": "value",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text" } ] } ], "rules": [ { "action": "set", "targets": ["a"], "when": "true" } ] } },
    { "name": "a show rule with a value", "path": "/rules/0", "contains": "value",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text" } ] } ], "rules": [ { "action": "show", "targets": ["a"], "when": "true", "value": "1" } ] } },
    { "name": "a rule naming a missing field", "path": "/rules/0/targets/0", "contains": "#b",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text" } ] } ], "rules": [ { "action": "show", "targets": ["b"], "when": "#a is 1" } ] } },
    { "name": "skip to something that is not a page", "path": "/rules/0/targets/0", "contains": "#a",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text" } ] } ], "rules": [ { "action": "skip_to", "targets": ["a"], "when": "true" } ] } },
    { "name": "a cascade from a missing field", "path": "/pages/0/items/0/cascade/from", "contains": "#country",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "select", "cascade": { "from": "country", "library": "states" } } ] } ] } },
    { "name": "the same choice value twice", "path": "/pages/0/items/0/choices/1/value", "contains": "twice",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "radio", "choices": [ { "value": "x", "label": "X" }, { "value": "x", "label": "Also X" } ] } ] } ] } },
    { "name": "a correct answer that is not a choice", "path": "/pages/0/items/0/scoring/correct", "contains": "not one of the choices",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "quiz", "choices": [ { "value": "x", "label": "X" } ], "scoring": { "correct": ["y"] } } ] } ] } },
    { "name": "a translation of a missing field", "path": "/translations/es/fields/b", "contains": "#b",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "text" } ] } ], "translations": { "es": { "fields": { "b": { "label": "B" } } } } } },
    { "name": "a bad language tag", "path": "/language", "contains": "pattern",
      "model": { "version": 1, "title": "T", "language": "English", "pages": [ { "id": "page_1", "items": [] } ] } },
    { "name": "a page prop named like the page's own property", "path": "/pages/0/props/title", "contains": "cannot be called",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [], "props": { "title": "x" } } ] } },
    { "name": "a choice with an unknown property", "path": "/pages/0/items/0/choices/0/colour", "contains": "Unknown property",
      "model": { "version": 1, "title": "T", "pages": [ { "id": "page_1", "items": [ { "id": "a", "type": "radio", "choices": [ { "value": "x", "label": "X", "colour": "red" } ] } ] } ] } }
  ]
}
