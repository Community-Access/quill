# Copy this file to `.env` for local development ONLY (run.py loads it via
# python-dotenv). In production, set these through your host's real secret
# mechanism -- an environment file outside any git-tracked directory, or a
# managed secret store -- never by committing a filled-in .env anywhere.
#
# See docs/planning/openai.md §6 for the full secret-management plan, and
# ai.md at the repository root for the deployment runbook.
#
# ---------------------------------------------------------------------------
# THIS SERVICE SENDS NO EMAIL.
# ---------------------------------------------------------------------------
# There is no SMTP host, no API key for a mail provider, and nothing here that
# would need one. Sign-in is the device-code flow -- a person reads eight
# characters into a web page -- so there is no address to verify, no password
# to reset and no confirmation to deliver. Alerts go to a webhook, not an
# inbox. That is a deliberate property worth keeping: no mail provider is one
# fewer account, one fewer secret, one fewer bill, and no deliverability
# problem to debug at the exact moment something is already wrong.

# --- Required ---------------------------------------------------------------
OPENAI_API_KEY=sk-REPLACE-ME
GATEWAY_SECRET_KEY=REPLACE-ME-run-python-c-import-secrets-print-secrets-token-hex-32

# --- Storage -----------------------------------------------------------------
DATABASE_URL=postgresql://quill_gateway:REPLACE-ME@localhost:5432/quill_ai_gateway
REDIS_URL=redis://localhost:6379/0

# Used only by docker-compose's postgres service, not read by the app itself
# (the app uses DATABASE_URL). Required by both compose files.
POSTGRES_PASSWORD=REPLACE-ME

# --- Admin access --------------------------------------------------------------
# Comma-separated device_ids permitted to reach /admin/* and /dashboard/*.
#
# This is the whole admin authentication story, and it is deliberately a
# deployment-time value rather than a database row: who may administer the
# Gateway must not be something the Gateway's own console can grant to itself.
#
# First-run order (there is no chicken-and-egg problem, but the order matters):
#   1. Leave this empty and start the service.
#   2. Connect a computer through the ordinary device-code flow -- the same
#      one every user goes through. Note the device_id it returns.
#   3. Put that device_id here and restart.
#   4. Sign in at /dashboard/login by pasting that device's bearer token.
#
# There is no separate admin password. The dashboard login is the same bearer
# token the JSON API uses, remembered in a signed, HttpOnly session cookie so
# it is not re-pasted on every page.
GATEWAY_ADMIN_ALLOWLIST=

# --- Public-facing --------------------------------------------------------------
# The base URL users' browsers reach. This is what goes in the
# verification_uri the desktop client reads aloud, so it must be the real
# public name, not the container's.
GATEWAY_PUBLIC_BASE_URL=https://ai.csedesigns.com

# --- Optional -------------------------------------------------------------------
# Only used to seed a brand-new database. After the first `seed-config`, the
# Models page in the dashboard is the authority on which model is default.
GATEWAY_OPENAI_MODEL=gpt-6-luna

# Where the 50%, 75%, 90% and 100% budget alerts go. Any endpoint that accepts
# a JSON {"text": "..."} POST: a Slack or Discord incoming webhook, or a
# self-hosted ntfy topic. Leave it empty and the alerts are written to a log
# nobody reads -- which means the first you hear of a runaway month is the
# service switching itself off. `flask --app run.py check-config` reports this
# as a problem for exactly that reason.
GATEWAY_ALERT_WEBHOOK_URL=

# Set to 1 ONLY for local http:// development, so the session cookie is sent
# without TLS. Never set this in production.
GATEWAY_DASHBOARD_INSECURE_COOKIE=
