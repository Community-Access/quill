{
  "schema": "quill.extension/1",
  "id": "com.quill.bundled.line-tools",
  "name": "Line Tools",
  "version": "2.0.0",
  "author": "QUILL Project",
  "description": "Bundled Quillin: join a line with the next one, a verb QUILL's core does not register.",
  "license": "MIT",
  "min_quill_version": "1.0.0",
  "capabilities": [
    "editor.read",
    "editor.write",
    "ui.announce",
    "ui.command"
  ],
  "main": "extension.py",
  "contributes": {
    "commands": [
      {
        "id": "ext.lines.join_next",
        "title": "Join with Next Line",
        "run": {
          "handler": "join_with_next_line"
        }
      }
    ],
    "menus": [
      {
        "parent": "Edit",
        "command": "ext.lines.join_next"
      }
    ]
  }
}
