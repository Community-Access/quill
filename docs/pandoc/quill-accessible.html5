<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"$if(lang)$ lang="$lang$" xml:lang="$lang$"$else$ lang="en" xml:lang="en"$endif$$if(dir)$ dir="$dir$"$endif$>
<head>
  <meta charset="utf-8" />
  <meta name="generator" content="pandoc $pandoc-version$" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
$for(author-meta)$
  <meta name="author" content="$author-meta$" />
$endfor$
$if(date-meta)$
  <meta name="dcterms.date" content="$date-meta$" />
$endif$
$if(keywords)$
  <meta name="keywords" content="$for(keywords)$$keywords$$sep$, $endfor$" />
$endif$
$if(description-meta)$
  <meta name="description" content="$description-meta$" />
$endif$
  <title>$if(title-prefix)$$title-prefix$ – $endif$$pagetitle$</title>
  <style>
    $styles.html()$
  </style>
$for(css)$
  <link rel="stylesheet" href="$css$" />
$endfor$
$for(header-includes)$
  $header-includes$
$endfor$
$if(math)$
  $math$
$endif$
  <style>
    /* Accessible skip link: off-screen until it receives keyboard focus. */
    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      background: #ffffff;
      color: #1a1a1a;
      padding: 0.5em 1em;
      border: 2px solid #1a1a1a;
      z-index: 1000;
    }
    .skip-link:focus { left: 0; }
    /* The skip link above targets main, and a focusable main needs a ring for
       the sighted keyboard user. These pages load no external stylesheet, so it
       has to be inline; the colour is the site theme's --focus, hardcoded
       because there is no token here. :focus-visible, not :focus -- tabindex="-1"
       makes main the click-focus target for every paragraph inside it, so
       :focus would box the whole page on any ordinary click. The offset is inset
       because main is full-bleed and an outset ring gets clipped into two
       vertical lines. */
    main[tabindex="-1"]:focus-visible {
      outline: 3px solid #b8540a;
      outline-offset: -3px;
    }
    /* WCAG AA overrides (>= 4.5:1 on the light code background) for the
       low-contrast default syntax-highlight token colors. */
    code span.al, code span.er { color: #c00000; }
    code span.an, code span.co, code span.cv { color: #5a5a5a; }
    code span.ss { color: #8a3a5a; }
    /* Pandoc's own styles.html partial, injected near the top of this template,
       ships `table { display: block; overflow-x: auto; }`. display: block takes
       the table role out of the accessibility tree in Blink and Gecko, and the
       row and cell roles go with it, so every rendered table reads as a flat run
       of words -- 62 of them in QUILL Lite's user guide alone, all of them
       keyboard reference tables, on a site whose readers are overwhelmingly
       screen-reader users. Restoring display: table is not a preference.

       The scroll affordance it was there for is given up rather than moved,
       because Pandoc emits a bare table with no wrapper element to hang overflow
       on -- the wrapper pattern compare.html uses is not available here. So the
       exchange is a certain and total loss of table semantics against a possible
       sideways page scroll on the widest tables, and the cells are taught to
       break so that stays possible rather than likely.

       This override also covers the governance pages built by
       .github/workflows/github-pages.yml, which installs Pandoc from apt at a
       version nobody pins -- whatever styles.html that ships, this wins. */
    table {
      display: table;
      overflow-x: visible;
    }
    table th,
    table td {
      overflow-wrap: break-word;
      word-break: break-word;
    }
  </style>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<main id="main-content" tabindex="-1">
$for(include-before)$
$include-before$
$endfor$
$if(title)$
<header id="title-block-header">
<h1 class="title">$title$</h1>
$if(subtitle)$
<p class="subtitle">$subtitle$</p>
$endif$
$for(author)$
<p class="author">$author$</p>
$endfor$
$if(date)$
<p class="date">$date$</p>
$endif$
$if(abstract)$
<div class="abstract">
<div class="abstract-title">$abstract-title$</div>
$abstract$
</div>
$endif$
</header>
$endif$
$if(toc)$
<nav id="$idprefix$TOC" role="doc-toc">
$if(toc-title)$
<h2 id="$idprefix$toc-title">$toc-title$</h2>
$endif$
$table-of-contents$
</nav>
$endif$
$body$
$for(include-after)$
$include-after$
$endfor$
</main>
</body>
</html>
